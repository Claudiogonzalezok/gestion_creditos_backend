# Credenciales para la DB de tests integration.
# Commiteado a propósito — son credenciales LOCALES de un Postgres aislado en docker.
# El contenedor se levanta con `npm run test:db:up`.

NODE_ENV=test

# Base de datos de test (puerto 5433 para no chocar con la dev en 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=gestion_creditos_test
DB_USER=postgres
DB_PASSWORD=postgres_test
DB_MAX_CONNECTIONS=5

# JWT secrets — valores arbitrarios para tests (jamás usar en otro entorno)
JWT_SECRET_INTERNAL=test_internal_secret_no_usar_en_prod
JWT_SECRET_PORTAL=test_portal_secret_no_usar_en_prod

# Zona horaria — debe coincidir con la del contenedor para que CURRENT_DATE sea coherente
TZ=America/Argentina/Buenos_Aires

# Salt rounds bajos para que bcrypt no demore tests
BCRYPT_SALT_ROUNDS=4
