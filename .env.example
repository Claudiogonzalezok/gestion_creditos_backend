# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_creditos
# DB_USER y DB_PASSWORD son obligatorios con NODE_ENV=production
# (el arranque falla si faltan). Usar un usuario propio, no el superusuario.
DB_USER=postgres
DB_PASSWORD=tu_password
DB_MAX_CONNECTIONS=10

# JWT — sistema interno (Admin, Vendedor, Cobrador)
# ⚠️ IMPORTANTE: el nombre exacto es JWT_SECRET_INTERNAL (no JWT_SECRET)
JWT_SECRET_INTERNAL=cambiar_por_string_largo_y_aleatorio_interno
# ℹ️  JWT_EXPIRY_INTERNAL no es leído por el código — la expiración se configura
#     desde el panel del Admin en Configuración > Seguridad (system_config).
JWT_EXPIRY_INTERNAL=8h

# JWT — portal público (Cliente)
# ⚠️ IMPORTANTE: el nombre exacto es JWT_SECRET_PORTAL (no JWT_SECRET_CLIENT)
JWT_SECRET_PORTAL=cambiar_por_string_largo_y_aleatorio_portal
# ℹ️  JWT_EXPIRY_PORTAL no es leído por el código — ídem JWT_EXPIRY_INTERNAL.
JWT_EXPIRY_PORTAL=30m

# CORS — URLs del frontend separadas por coma
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Proxies confiables para obtener la IP real del cliente (rate limit de login).
# Default loopback: nginx en el mismo host. Acepta true/false, nro de saltos o subredes.
# No usar true a ciegas (permite falsificar X-Forwarded-For).
TRUST_PROXY=loopback

# Zona horaria para cron jobs
TZ=America/Argentina/Buenos_Aires

# Seguridad
BCRYPT_SALT_ROUNDS=10

# Rutas de testing E2E (/api/test). Solo para `npm run dev:e2e`.
# Prohibido en producción: el arranque falla con NODE_ENV=production.
ENABLE_TEST_ROUTES=false

# Notificaciones salientes (recuperación de contraseña, aviso de mora).
# log = no envía: guarda/imprime el mensaje (solo desarrollo/test).
# disabled = los endpoints que envían responden 503 NOTIFIER_NOT_CONFIGURED.
# En producción `log` se ignora: queda disabled hasta enchufar un transporte
# real con notifier.setTransport() (no hay dependencia SMTP instalada).
NOTIFIER_TRANSPORT=log
# Pantalla de reseteo del frontend (se agrega ?token=...).
# Default: primer ALLOWED_ORIGINS + /reset-password.
PASSWORD_RESET_URL=http://localhost:4200/reset-password
# Límite por IP de /api/auth/forgot-password y /api/auth/reset-password.
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
