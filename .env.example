# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_creditos
DB_USER=postgres
DB_PASSWORD=tu_password
DB_MAX_CONNECTIONS=10

# JWT — sistema interno (Admin, Vendedor, Cobrador)
# ⚠️ IMPORTANTE: el nombre exacto es JWT_SECRET_INTERNAL (no JWT_SECRET)
JWT_SECRET_INTERNAL=cambiar_por_string_largo_y_aleatorio_interno
# ℹ️  JWT_EXPIRY_INTERNAL no es leído por el código — la expiración se configura
#     desde el panel del Admin en Configuración > Seguridad (system_config).
JWT_EXPIRY_INTERNAL=8h

# JWT — portal público (Cliente)
# ⚠️ IMPORTANTE: el nombre exacto es JWT_SECRET_PORTAL (no JWT_SECRET_CLIENT)
JWT_SECRET_PORTAL=cambiar_por_string_largo_y_aleatorio_portal
# ℹ️  JWT_EXPIRY_PORTAL no es leído por el código — ídem JWT_EXPIRY_INTERNAL.
JWT_EXPIRY_PORTAL=30m

# CORS — URLs del frontend separadas por coma
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Zona horaria para cron jobs
TZ=America/Argentina/Buenos_Aires

# Seguridad
BCRYPT_SALT_ROUNDS=10

# SMTP — envío de email para notificaciones (best-effort)
# Si se omiten estas variables, el mailer no-opera y solo loguea un warning
# (no rompe el flujo de negocio que dispara la notificación).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@finflow.local
SMTP_SECURE=false
