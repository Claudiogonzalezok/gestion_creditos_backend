{
  "name": "gestion_creditos_backend",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "dev:e2e": "cross-env DISABLE_LOGIN_RATE_LIMIT=true ENABLE_TEST_ROUTES=true nodemon src/app.js",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.unit.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:integration:local": "cross-env NODE_ENV=test DB_HOST=localhost DB_PORT=5432 DB_NAME=gestion_creditos_test DB_USER=postgres jest --config jest.integration.config.js --runInBand",
    "test:pl05:local": "cross-env NODE_ENV=test DB_HOST=localhost DB_PORT=5432 DB_NAME=gestion_creditos_test DB_USER=postgres jest --config jest.integration.config.js --runInBand tests/integration/planilla-inclusion-rules.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "seed": "node src/seeds/index.seed.js",
    "migration:run": "node src/scripts/migration.run.js",
    "db:setup": "npm run migration:run && npm run seed",
    "db:reset": "node src/scripts/db.reset.js && npm run seed",
    "db:studio": "node src/scripts/db.studio.js",
    "cron:run": "node src/scripts/run-cron.js",
    "logs:cron": "pm2 logs finflow-backend --lines 500 --nostream | grep -i job",
    "logs:cron:live": "pm2 logs finflow-backend --raw | grep -i --line-buffered job"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.1"
  }
}
